{
  "name": "openbuddies",
  "version": "0.1.0",
  "description": "A self-hosted AI homework tutor: a pair tutor, not an answer machine.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "openbuddies": "dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "dev:web": "vite",
    "demo": "tsx watch --clear-screen=false scripts/demo.ts",
    "watch": "tsx watch --clear-screen=false --exclude 'web/**' --exclude 'dist/**' scripts/dev.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@hono/node-server": "^2.1.5",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "open": "^11.0.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "web-push": "3.6.7",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
