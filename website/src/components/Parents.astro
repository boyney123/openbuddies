---
// For parents: a look at the parent page (plain and light, like the app's), and what it lets you control.
import Buddy from "./Buddy.astro";
import Art from "./Art.astro";
import Glyph from "./Glyph.astro";
import Icon from "./Icon.astro";

const controls = [
  { icon: "eye" as const, title: "Read every message", body: "Every chat, with every buddy, is on your parent page. Nothing is hidden or deleted." },
  { icon: "bell" as const, title: "Alerts", body: "If your child says something worrying, you get an alert on your parent page before the buddy even replies." },
  { icon: "dial" as const, title: "Help level per subject", body: "Strict for maths, relaxed for history? Choose how much help each child gets, subject by subject." },
  { icon: "globe" as const, title: "Internet: off, trusted or open", body: "Decide whether buddies can look things up, and where. The search goes out without your child's details." },
  { icon: "hourglass" as const, title: "A daily allowance", body: "Set how much AI each child can use a day. When it's used up, the buddy rests until tomorrow." },
  { icon: "apps" as const, title: "Apps you approve", body: "Read an app in full before you add it, then switch it on for the children you choose." },
  { icon: "phone" as const, title: "Devices you control", body: "Pair a phone with a QR code. Unpair it, and it's cut off instantly." },
  { icon: "lock" as const, title: "Behind your PIN", body: "The parent page only opens on your own devices, behind a PIN only you know." },
];

const nav = [
  { icon: "home" as const, label: "Overview", on: true },
  { icon: "users" as const, label: "Children" },
  { icon: "list" as const, label: "Sessions" },
  { icon: "bell" as const, label: "Alerts" },
  { icon: "grid" as const, label: "Apps" },
  { icon: "phone" as const, label: "Devices" },
];
---

<section id="parents" class="relative px-4 py-20 md:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold tracking-wider text-coral uppercase">For parents</p>
      <h2 class="mt-2 text-4xl tracking-tight md:text-5xl">See everything. Set the rules.</h2>
      <p class="mt-4 text-lg text-muted">Every chat, buddy and file is on your parent page. Changes apply instantly.</p>
    </div>

    {/* The parent page. */}
    <div class="reveal relative mt-14">
      <div class="absolute -top-14 right-6 z-10 hidden w-24 md:block" aria-hidden="true">
        <div class="animate-bob" style="animation-duration:4s">
          <Buddy color="coral" wear={["sunglasses"]} mood="happy" class="w-full" label="" />
        </div>
      </div>
      <div class="overflow-hidden rounded-[1.5rem] border border-line bg-white shadow-[0_30px_70px_-30px_rgb(16_42_92/0.35)]">
        <div class="flex items-center gap-2 border-b border-[#e6e9ef] bg-[#f8f9fb] px-4 py-3" aria-hidden="true">
          <span class="size-3 rounded-full bg-[#ff6159]"></span>
          <span class="size-3 rounded-full bg-[#ffbd2e]"></span>
          <span class="size-3 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 rounded-md bg-white px-3 py-1 text-xs text-muted ring-1 ring-[#e6e9ef]">home-mac.local/parent</span>
        </div>
        <div class="grid md:grid-cols-[200px_1fr]" role="img" aria-label="The parent page: today's activity, a session transcript and a recent alert">
          <aside class="hidden border-r border-[#e6e9ef] p-3 md:block" aria-hidden="true">
            <ul class="space-y-0.5 text-sm font-medium">
              {
                nav.map((n) => (
                  <li class:list={["flex items-center gap-2.5 rounded-lg px-3 py-2", n.on ? "bg-[#f3f5f8] text-[#111827]" : "text-[#646d7e]"]}>
                    <Glyph name={n.icon} class="size-4" />
                    {n.label}
                  </li>
                ))
              }
            </ul>
          </aside>
          <div class="grid gap-4 bg-white p-4 md:p-6 lg:grid-cols-[1fr_1.2fr]" aria-hidden="true">
            <div class="space-y-4">
              {/* Children. */}
              {
                [
                  { name: "Sam", year: "Year 6", buddies: ["blue", "mint", "grape"], msgs: 42, level: "Strict" },
                  { name: "Maya", year: "Year 3", buddies: ["berry", "sunny"], msgs: 17, level: "Balanced" },
                ].map((k) => (
                  <div class="rounded-[0.625rem] border border-[#e6e9ef] p-4">
                    <div class="flex items-center justify-between">
                      <div>
                        <p class="font-semibold text-[#111827]">{k.name}</p>
                        <p class="text-xs text-[#646d7e]">
                          {k.year} · {k.msgs} messages today
                        </p>
                      </div>
                      <span class="rounded-md bg-[#e8f0ff] px-2 py-1 text-xs font-semibold text-tutor-blue">{k.level}</span>
                    </div>
                    <div class="mt-3 flex -space-x-1">
                      {k.buddies.map((b) => (
                        <Buddy color={b as any} class="size-10" label="" />
                      ))}
                    </div>
                    <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-[#f3f5f8]">
                      <div class="h-full rounded-full bg-tutor-blue" style={`width:${k.msgs + 20}%`} />
                    </div>
                    <p class="mt-1.5 text-[11px] text-[#646d7e]">Daily allowance</p>
                  </div>
                ))
              }
              <div class="flex items-start gap-3 rounded-[0.625rem] border border-[#ffd9d4] bg-[#fff6f5] p-4">
                <Glyph name="alert" class="mt-0.5 size-4 shrink-0 text-coral" />
                <div>
                  <p class="text-sm font-semibold text-[#111827]">Sam might be feeling low</p>
                  <p class="text-xs text-[#646d7e]">Sent to your phone · 4:12pm · Read the chat</p>
                </div>
              </div>
            </div>

            {/* A session transcript, with what the buddy decided. */}
            <div class="rounded-[0.625rem] border border-[#e6e9ef]">
              <div class="flex items-center justify-between border-b border-[#e6e9ef] px-4 py-3">
                <p class="text-sm font-semibold text-[#111827]">Sam · Maths with Pip</p>
                <p class="text-xs text-[#646d7e]">Today, 3:40pm</p>
              </div>
              <div class="space-y-3 p-4 text-[13px]">
                <div>
                  <p class="w-fit max-w-[85%] rounded-xl bg-[#f3f5f8] px-3 py-2 text-[#1b2430]">just tell me the answer pls</p>
                  <p class="mt-1 flex flex-wrap gap-1 text-[10px] font-semibold">
                    <span class="rounded bg-[#fff4dc] px-1.5 py-0.5 text-[#8a5a00]">asked for answer</span>
                    <span class="rounded bg-[#e8f0ff] px-1.5 py-0.5 text-tutor-blue">gave a question</span>
                  </p>
                </div>
                <p class="ml-auto w-fit max-w-[85%] rounded-xl bg-tutor-blue px-3 py-2 text-white">Can we add the bottom numbers straight away, or do they need to match?</p>
                <div class="flex items-center gap-2 rounded-lg border border-dashed border-[#e6e9ef] px-3 py-2 text-[11px] text-[#646d7e]">
                  <Icon name="shield" class="size-4 shrink-0" />
                  1 draft blocked: it gave the answer away. Rewritten before Sam saw it.
                </div>
                <div>
                  <p class="w-fit max-w-[85%] rounded-xl bg-[#f3f5f8] px-3 py-2 text-[#1b2430]">8/12!!</p>
                  <p class="mt-1 flex flex-wrap gap-1 text-[10px] font-semibold">
                    <span class="rounded bg-[#e2f7ec] px-1.5 py-0.5 text-[#167a50]">working it out</span>
                    <span class="rounded bg-[#e8f0ff] px-1.5 py-0.5 text-tutor-blue">hint 2</span>
                  </p>
                </div>
                <p class="ml-auto w-fit max-w-[85%] rounded-xl bg-tutor-blue px-3 py-2 text-white">Brilliant! Now do the same with 1/4.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <ul class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        controls.map((c, i) => (
          <li class="reveal rounded-3xl border border-line bg-white p-5" style={`transition-delay:${(i % 4) * 70}ms`}>
            <span class="flex size-14 items-center justify-center rounded-2xl bg-blue-soft">
              <Icon name={c.icon} class="size-9" />
            </span>
            <h3 class="mt-4 text-[17px]">{c.title}</h3>
            <p class="mt-1.5 text-[15px] leading-relaxed text-muted">{c.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="reveal mt-10 flex flex-col items-center gap-5 rounded-[2rem] bg-navy p-6 text-center text-white md:flex-row md:p-8 md:text-left">
      <Art name="shield" class="h-20 w-auto shrink-0" />
      <div>
        <h3 class="text-xl text-white">The rules live with you, not with your child</h3>
        <p class="mt-1 text-white/75">
          Your child's phone only ever gets the buddy's replies. The rules, the prompts and your AI key stay on your home
          computer, where a curious kid can't get at them.
        </p>
      </div>
    </div>
  </div>
</section>
