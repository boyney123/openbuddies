---
// A hello from David and Jackson (as on the homepage's About us) at the top of the docs, with a star on GitHub as the
// way to join in. Styled in styles/docs.css.
import { SITE } from "../site";
import Buddy from "./Buddy.astro";
import GithubMark from "./GithubMark.astro";
---

<aside aria-label="A note from David and Jackson" class="docs-welcome not-content">
  <div class="docs-welcome__buddies" aria-hidden="true">
    <figure>
      <Buddy color="mint" wear={["glasses", "moustache", "flatcap"]} mood="happy" class="docs-welcome__david" label="" />
      <figcaption class="docs-welcome__name docs-welcome__name--mint">David</figcaption>
    </figure>
    <figure>
      <Buddy color="coral" wear={["cap"]} mood="wink" star class="docs-welcome__jackson" label="" />
      <figcaption class="docs-welcome__name docs-welcome__name--coral">Jackson, 11</figcaption>
    </figure>
  </div>
  <div class="docs-welcome__bubble">
    <p class="docs-welcome__title">Hi, we're David and Jackson!</p>
    <p>
      We're building {SITE.name} for ourselves: a way for our family to use AI safely, in a fun and friendly way.
    </p>
    <p>
      As we build it, we want to share it with you and your family too. So feel free to check it out, fork it, and
      contribute back. And if your family enjoys their buddies, a star on GitHub helps other parents find it.
    </p>
    <a class="docs-welcome__cta" href={SITE.github}>
      <GithubMark class="docs-welcome__cta-icon" />
      Join us: star {SITE.name} on GitHub
    </a>
  </div>
</aside>
