---
// OpenBuddies' own icons, drawn like the app's illustrations (../web/src/components/brand.tsx): chunky shapes in the brand
// colours, a navy outline, rounded joins and the odd coral spark. 48 x 48. For small UI marks inside buttons and text,
// use Glyph.astro instead.
export type IconName =
  | "eye"
  | "bell"
  | "dial"
  | "globe"
  | "hourglass"
  | "apps"
  | "phone"
  | "lock"
  | "bulb"
  | "shield"
  | "house"
  | "key"
  | "no-ads"
  | "wifi-lock"
  | "code"
  | "chat"
  | "check"
  | "cross"
  | "heart"
  | "star";

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
const N = "#102A5C";
const line = { stroke: N, "stroke-width": 3, "stroke-linejoin": "round", "stroke-linecap": "round" } as const;
---

<svg viewBox="0 0 48 48" class={className} aria-hidden="true" fill="none">
  {
    name === "eye" && (
      <>
        <path d="M4 24Q14 10 24 10Q34 10 44 24Q34 38 24 38Q14 38 4 24Z" fill="#fff" {...line} />
        <circle cx="24" cy="24" r="8.5" fill="#2F80FF" {...line} />
        <circle cx="24" cy="24" r="3.5" fill={N} />
        <circle cx="27" cy="21" r="1.8" fill="#fff" />
      </>
    )
  }
  {
    name === "bell" && (
      <>
        <path d="M12 33V22Q12 11 24 11Q36 11 36 22V33L39 37H9Z" fill="#FFB020" {...line} />
        <circle cx="24" cy="40" r="4" fill="#FF6B5E" {...line} />
        <circle cx="24" cy="8" r="2.5" fill={N} />
        <path d="M17 19Q18 15 22 14.5" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
        <path d="M41 10L44 6M42 16L46 15" stroke="#FF6B5E" stroke-width="2.8" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "dial" && (
      <>
        <path d="M6 32A18 18 0 0 1 42 32Z" fill="#fff" {...line} />
        <path d="M9.5 30A14.5 14.5 0 0 1 16 19" stroke="#34C98A" stroke-width="5" stroke-linecap="round" />
        <path d="M19 17.3A14.5 14.5 0 0 1 29 17.3" stroke="#FFB020" stroke-width="5" stroke-linecap="round" />
        <path d="M32 19A14.5 14.5 0 0 1 38.5 30" stroke="#FF6B5E" stroke-width="5" stroke-linecap="round" />
        <path d="M24 32L31 21" stroke={N} stroke-width="3.5" stroke-linecap="round" />
        <circle cx="24" cy="32" r="3.5" fill={N} />
        <path d="M6 36H42" {...line} />
      </>
    )
  }
  {
    name === "globe" && (
      <>
        <circle cx="24" cy="24" r="17" fill="#2F80FF" {...line} />
        <path d="M14 13Q20 16 18 21Q15 24 18 28Q21 31 19 37Q12 34 9 27Q8 18 14 13Z" fill="#34C98A" />
        <path d="M30 9Q34 14 31 18Q28 21 32 24Q36 26 40 22Q41 13 30 9Z" fill="#34C98A" />
        <path d="M33 31Q37 30 38 33Q36 37 33 38Q31 35 33 31Z" fill="#34C98A" />
        <circle cx="24" cy="24" r="17" {...line} />
        <path d="M15 11Q19 9 22 8.5" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity="0.6" />
      </>
    )
  }
  {
    name === "hourglass" && (
      <>
        <path d="M14 9H34Q34 20 24 24Q34 28 34 39H14Q14 28 24 24Q14 20 14 9Z" fill="#fff" {...line} />
        <path d="M17.5 14H30.5Q29 19 24 21.5Q19 19 17.5 14Z" fill="#FFB020" />
        <path d="M24 27Q30 30 31 36H17Q18 30 24 27Z" fill="#FFB020" />
        <path d="M10 8H38M10 40H38" stroke={N} stroke-width="4" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "apps" && (
      <>
        <rect x="6" y="6" width="16" height="16" rx="5" fill="#2F80FF" {...line} />
        <rect x="26" y="6" width="16" height="16" rx="5" fill="#FF6B5E" {...line} />
        <rect x="6" y="26" width="16" height="16" rx="5" fill="#34C98A" {...line} />
        <rect x="26" y="26" width="16" height="16" rx="5" fill="#fff" {...line} stroke-dasharray="4 3.5" />
        <path d="M34 30V38M30 34H38" stroke={N} stroke-width="3" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "phone" && (
      <>
        <rect x="12" y="4" width="24" height="40" rx="6" fill="#fff" {...line} />
        <rect x="15.5" y="9" width="17" height="26" rx="3" fill="#2F80FF" />
        <rect x="19" y="18" width="2.6" height="5" rx="1.3" fill={N} />
        <rect x="26.4" y="18" width="2.6" height="5" rx="1.3" fill={N} />
        <path d="M20.5 26.5Q24 29 27.5 26.5" stroke={N} stroke-width="2" stroke-linecap="round" />
        <path d="M21 39.5H27" stroke={N} stroke-width="2.5" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "lock" && (
      <>
        <path d="M15 21V15Q15 6 24 6Q33 6 33 15V21" stroke={N} stroke-width="4" stroke-linecap="round" />
        <rect x="9" y="20" width="30" height="23" rx="6" fill="#FFB020" {...line} />
        <circle cx="24" cy="29.5" r="3.2" fill={N} />
        <path d="M24 31V36" stroke={N} stroke-width="3" stroke-linecap="round" />
        <path d="M14 25V27" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
      </>
    )
  }
  {
    name === "bulb" && (
      <>
        <path d="M24 6Q36 6 36 18Q36 24 31 28V32H17V28Q12 24 12 18Q12 6 24 6Z" fill="#FFB020" {...line} />
        <rect x="17" y="32" width="14" height="6" rx="2" fill="#fff" {...line} />
        <path d="M20 42H28" stroke={N} stroke-width="3" stroke-linecap="round" />
        <path d="M19 14Q20 11 23 10.5" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity="0.75" />
        <path d="M40 8L44 5M42 15L46 15M5 15L2 14M7 8L4 5" stroke="#FF6B5E" stroke-width="2.6" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "shield" && (
      <>
        <path d="M24 4L40 10V22Q40 36 24 44Q8 36 8 22V10Z" fill="#2F80FF" {...line} />
        <path d="M16 23L22 29L32 18" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M13 13V19" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity="0.5" />
      </>
    )
  }
  {
    name === "house" && (
      <>
        <path d="M24 5L44 22H4Z" fill="#FF6B5E" {...line} />
        <rect x="8" y="21" width="32" height="22" rx="3" fill="#fff" {...line} />
        <rect x="33" y="8" width="5" height="9" rx="1" fill="#FFB020" {...line} />
        <rect x="13" y="26" width="12" height="10" rx="2.5" fill="#2F80FF" {...line} stroke-width="2.5" />
        <rect x="29" y="28" width="7" height="15" rx="2" fill="#34C98A" {...line} stroke-width="2.5" />
      </>
    )
  }
  {
    name === "key" && (
      <>
        <circle cx="16" cy="18" r="10" fill="#FFB020" {...line} />
        <circle cx="13.5" cy="15.5" r="3" fill="#fff" stroke={N} stroke-width="2.5" />
        <path d="M23 25L40 42" stroke={N} stroke-width="6" stroke-linecap="round" />
        <path d="M23 25L40 42" stroke="#FFB020" stroke-width="2.4" stroke-linecap="round" />
        <path d="M33 35L37 31M37.5 39.5L41 36" stroke={N} stroke-width="3" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "no-ads" && (
      <>
        <rect x="5" y="11" width="38" height="26" rx="6" fill="#fff" {...line} />
        <path d="M12 30L16 18L20 30M13.3 26H18.7" stroke="#2F80FF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M25 18V30H28Q34 30 34 24Q34 18 28 18Z" stroke="#2F80FF" stroke-width="3" stroke-linejoin="round" />
        <circle cx="24" cy="24" r="19" stroke="#FF6B5E" stroke-width="4" />
        <path d="M11 37L37 11" stroke="#FF6B5E" stroke-width="4" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "wifi-lock" && (
      <>
        <path d="M5 18Q24 2 43 18" stroke={N} stroke-width="7" stroke-linecap="round" />
        <path d="M5 18Q24 2 43 18" stroke="#2F80FF" stroke-width="3" stroke-linecap="round" />
        <path d="M11 24Q24 13 37 24" stroke={N} stroke-width="7" stroke-linecap="round" />
        <path d="M11 24Q24 13 37 24" stroke="#2F80FF" stroke-width="3" stroke-linecap="round" />
        <path d="M19 29V27Q19 23 24 23Q29 23 29 27V29" stroke={N} stroke-width="3" stroke-linecap="round" />
        <rect x="15" y="28" width="18" height="15" rx="4" fill="#FFB020" {...line} />
        <circle cx="24" cy="35" r="2.3" fill={N} />
      </>
    )
  }
  {
    name === "code" && (
      <>
        <rect x="4" y="8" width="40" height="32" rx="6" fill="#fff" {...line} />
        <path d="M4 16H44" {...line} />
        <circle cx="10" cy="12" r="1.6" fill="#FF6B5E" />
        <circle cx="15" cy="12" r="1.6" fill="#FFB020" />
        <circle cx="20" cy="12" r="1.6" fill="#34C98A" />
        <path d="M17 23L12 28L17 33M31 23L36 28L31 33" stroke="#2F80FF" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M26.5 21.5L21.5 34.5" stroke="#FF6B5E" stroke-width="3.2" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "chat" && (
      <>
        <path d="M11 7H37Q43 7 43 13V27Q43 33 37 33H22L13 41L14 33H11Q5 33 5 27V13Q5 7 11 7Z" fill="#2F80FF" {...line} />
        <circle cx="15.5" cy="20" r="2.6" fill="#fff" />
        <circle cx="24" cy="20" r="2.6" fill="#fff" />
        <circle cx="32.5" cy="20" r="2.6" fill="#fff" />
      </>
    )
  }
  {
    name === "check" && (
      <>
        <circle cx="24" cy="24" r="19" fill="#34C98A" {...line} />
        <path d="M15 24.5L21.5 31L33 18" stroke="#fff" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
      </>
    )
  }
  {
    name === "cross" && (
      <>
        <circle cx="24" cy="24" r="19" fill="#E3E8F1" stroke="#9AA6BA" stroke-width="3" />
        <path d="M17 17L31 31M31 17L17 31" stroke="#7A879D" stroke-width="4.5" stroke-linecap="round" />
      </>
    )
  }
  {
    name === "heart" && (
      <>
        <path d="M24 41Q6 29 6 17Q6 8 15 8Q21 8 24 14Q27 8 33 8Q42 8 42 17Q42 29 24 41Z" fill="#FF6B5E" {...line} />
        <path d="M12 16Q12 13 15 12.5" stroke="#fff" stroke-width="2.5" stroke-linecap="round" opacity="0.7" />
      </>
    )
  }
  {
    name === "star" && (
      <path d="M24 4L29.6 16.2L42.8 17.6L33 26.6L35.7 39.6L24 33L12.3 39.6L15 26.6L5.2 17.6L18.4 16.2Z" fill="#FFB020" {...line} />
    )
  }
</svg>
