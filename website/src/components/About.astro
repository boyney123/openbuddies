---
// Who's behind it: a dad and his son, who built it for their own family first.
import { SITE } from "../site";
import Buddy from "./Buddy.astro";
import Cloud from "./Cloud.astro";
import Icon from "./Icon.astro";
---

<section id="about" class="relative overflow-hidden px-4 py-20 md:py-28">
  <div class="reveal relative mx-auto max-w-3xl overflow-hidden rounded-[2.5rem] border border-line bg-white px-6 pt-10 pb-10 text-center shadow-[0_30px_60px_-35px_rgb(16_42_92/0.4)] md:px-14 md:pb-14">
    {/* A little sky behind the two of us. */}
    <div class="absolute inset-x-0 top-0 h-56 bg-gradient-to-b from-[#dbe8ff] to-white" aria-hidden="true"></div>
    <Cloud class="cloud-drift-local absolute top-6 w-20" style="--dur:50s;--delay:-14s" />
    <Cloud class="cloud-drift-local absolute top-16 w-14 opacity-80" style="--dur:65s;--delay:-40s" />

    <div class="relative flex items-end justify-center gap-6 md:gap-10" aria-hidden="true">
      <figure class="flex flex-col items-center">
        <div class="w-32 animate-bob md:w-36" style="animation-duration:5.5s">
          <Buddy color="mint" wear={["glasses", "moustache", "flatcap"]} mood="happy" track class="w-full" label="" />
        </div>
        <figcaption class="-mt-3 rounded-full bg-mint-soft px-3 py-1 text-sm font-bold text-navy">David</figcaption>
      </figure>
      <Icon name="heart" class="mb-14 size-8 animate-pulse" />
      <figure class="flex flex-col items-center">
        <div class="w-24 animate-bob md:w-28" style="animation-duration:4.5s;animation-delay:-1.5s">
          <Buddy color="coral" wear={["cap"]} mood="wink" track star class="w-full" label="" />
        </div>
        <figcaption class="-mt-2 rounded-full bg-coral-soft px-3 py-1 text-sm font-bold text-navy">Jackson, 11</figcaption>
      </figure>
    </div>

    <p class="relative mt-10 text-sm font-bold tracking-wider text-coral uppercase">About us</p>
    <h2 class="relative mt-2 text-4xl tracking-tight md:text-5xl">Made by a dad and his son</h2>
    <div class="relative mx-auto mt-5 max-w-xl space-y-4 text-lg leading-relaxed text-muted">
      <p>
        Hi, we're David and Jackson. We think AI should help children learn, create and explore, but we couldn't find a way
        to use it as a family that we felt good about.
      </p>
      <p>
        So we built {SITE.name} for ourselves: self-hosted, open source, and with a parent in the loop. Now we'd love to
        share it with your family too.
      </p>
    </div>
    <p class="relative mt-8 text-xl font-extrabold text-navy">David &amp; Jackson</p>
  </div>
</section>
